{
  "name": "paddock-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "guide": "node ../../tools/docs/build-docs.mjs --guide-book src/lib/guide.generated.json",
    "predev": "npm run guide",
    "dev": "vite",
    "prebuild": "npm run guide",
    "build": "vite build",
    "precheck": "npm run guide",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.svelte.json",
    "pretest": "npm run guide",
    "test": "node --test src/lib/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "typescript": "5.6.3",
    "vite": "^6.3.6"
  }
}
